<section class="bg-parish-blue text-white"><div class="max-w-4xl mx-auto px-6 py-16"><p class="text-sm font-semibold tracking-[0.18em] uppercase text-white/70">St. Edward the Confessor</p><h1 class="mt-3 text-4xl md:text-5xl font-bold heading-serif">Parish Office Requests</h1><p class="mt-5 max-w-2xl text-lg text-white/85">These pages describe information the parish office may need. Online submission is not available yet.</p></div></section>
<section class="max-w-4xl mx-auto px-6 py-14"><div class="rounded-xl border border-amber-200 bg-amber-50 p-6 text-stone-800"><h2 class="text-xl font-bold heading-serif">No online forms are active</h2><p class="mt-2">Nothing on this page collects or transmits personal information. Please use the parish office’s ordinary contact path for current help.</p></div><div class="mt-10 grid gap-5 sm:grid-cols-2">{% set requests = [["Baptism", "/forms/baptism/", "Begin a baptism inquiry."], ["Confirmation", "/forms/confirmation/", "Begin a Confirmation inquiry."], ["First Holy Communion", "/forms/first-holy-communion/", "Begin a First Holy Communion inquiry."], ["Marriage", "/forms/marriage/", "Begin a marriage inquiry."], ["Funerals and Death", "/forms/funeral/", "Request funeral or pastoral follow-up."], ["Parish Census", "/forms/parish-census/", "Update household information through the parish office."], ["Baptismal Certificate Request", "/forms/baptismal-certificate-request/", "Learn what the parish office needs to review a request."], ["Mausoleum Application", "/forms/mausoleum-application/", "Online applications are not available."]] %}{% for request in requests %}<a class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm transition hover:border-parish-blue hover:shadow-md" href="{{ request[1] }}"><h2 class="text-xl font-bold heading-serif text-parish-blue">{{ request[0] }}</h2><p class="mt-2 text-stone-600">{{ request[2] }}</p></a>{% endfor %}</div></section>
