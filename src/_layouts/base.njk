<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "St. Edward the Confessor" }} | St. Edward Catholic Church, Tallulah</title>
  <link rel="stylesheet" href="https://cdn.tailwindcss.com">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&display=swap');
    
    .heading-serif { 
      font-family: 'Playfair Display', Georgia, serif; 
    }
    
    .nav-link {
      transition: color 0.2s ease;
    }
    .nav-link:hover {
      color: #1e3a5f;
    }
    
    .bulletin-card {
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .bulletin-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
      border-color: #1e3a5f;
    }
    
    .parish-blue {
      color: #1e3a5f;
    }
    .bg-parish-blue {
      background-color: #1e3a5f;
    }
  </style>
</head>
<body class="bg-stone-50 text-stone-800 font-sans">
  <!-- Navigation -->
  <nav class="bg-white border-b border-stone-200 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex justify-between items-center h-20">
        <a href="/" class="flex items-center gap-3">
          <div class="w-10 h-10 bg-parish-blue rounded-full flex items-center justify-center">
            <span class="text-white text-xl font-bold">SE</span>
          </div>
          <div>
            <span class="font-bold text-2xl heading-serif parish-blue">St. Edward the Confessor</span>
          </div>
        </a>
        
        <div class="hidden md:flex items-center gap-8 text-sm font-medium">
          <a href="/mass-times" class="nav-link">Mass Times</a>
          <a href="/about" class="nav-link">About</a>
          <a href="/contact" class="nav-link">Contact</a>
        </div>
        
        <div class="md:hidden">
          <button id="mobile-menu-btn" class="p-2 text-stone-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </nav>

  {{ content | safe }}

  <!-- Footer -->
  <footer class="bg-parish-blue text-white/90">
    <div class="max-w-6xl mx-auto px-6 py-14">
      <div class="grid md:grid-cols-2 gap-y-8">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-9 h-9 bg-white/10 rounded-full flex items-center justify-center">
              <span class="text-white text-lg font-bold">SE</span>
            </div>
            <span class="font-bold text-xl heading-serif">St. Edward the Confessor</span>
          </div>
          <p class="text-white/70 max-w-sm">
            Catholic Church • Tallulah, Louisiana<br>
            Diocese of Alexandria
          </p>
        </div>
        
        <div class="flex flex-col md:items-end gap-2 text-sm">
          <a href="/mass-times" class="hover:text-white transition">Mass Times</a>
          <a href="/about" class="hover:text-white transition">About the Parish</a>
          <a href="/contact" class="hover:text-white transition">Contact Us</a>
        </div>
      </div>
      
      <div class="mt-12 pt-8 border-t border-white/10 text-xs text-white/50 flex flex-col md:flex-row md:items-center gap-y-2 md:justify-between">
        <div>© 2026 St. Edward the Confessor Catholic Church. All rights reserved.</div>
        <div>Hosted on Netlify</div>
      </div>
    </div>
  </footer>

  <script>
    // Mobile menu
    document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
      const nav = document.querySelector('nav .hidden.md\\:flex');
      if (nav) nav.classList.toggle('hidden');
    });
  </script>
</body>
</html>