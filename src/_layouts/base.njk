<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or 'Bulletins, Mass times, confession, catechesis, and parish information for St. Edward the Confessor Catholic Church in Tallulah, Louisiana.' }}">
  <title>{% if title and title != "Home" %}{{ title }} | {% endif %}St. Edward Catholic Church, Tallulah</title>
  <link rel="icon" href="/images/glyph/St%20Edward%20Glyph%20Outlines.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="St. Edward Parish Bulletins" href="/feed.xml">

  <!-- Local Tailwind CSS (built) -->
  <link rel="stylesheet" href="/assets/css/tailwind.css">
</head>
<body class="bg-stone-50 text-stone-800 font-sans">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-white focus:px-5 focus:py-3 focus:font-semibold focus:text-parish-blue focus:shadow-lg">Skip to content</a>
  <!-- Navigation -->
  <nav class="bg-white border-b border-stone-200 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex justify-between items-center h-20">
        <a href="/" class="flex items-center gap-3" aria-label="St. Edward the Confessor home">
          <img src="/images/glyph/St%20Edward%20Glyph%20Outlines.svg" alt="" class="h-12 w-7 shrink-0">
          <div>
            <span class="font-bold text-xl sm:text-2xl heading-serif parish-blue">
              <span class="sm:hidden">St. Edward</span>
              <span class="hidden sm:inline">St. Edward the Confessor</span>
            </span>
          </div>
        </a>
        
        <div class="flex items-center text-sm font-medium">
          <a href="/past-bulletins/" class="nav-link">Past Bulletins</a>
        </div>
      </div>
    </div>
  </nav>

  <main id="main-content">
    {{ content | safe }}
  </main>

  <!-- Footer -->
  <footer class="bg-parish-blue text-white/90">
    <div class="max-w-6xl mx-auto px-6 py-14">
      <div class="grid md:grid-cols-2 gap-y-8">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <img src="/images/glyph/St%20Edward%20Glyph%20Outlines.svg" alt="" class="h-14 w-8 brightness-0 invert opacity-90">
            <span class="font-bold text-xl heading-serif">St. Edward the Confessor</span>
          </div>
          <p class="text-white/70 max-w-sm">
            Catholic Church • Tallulah, Louisiana<br>
            Diocese of Alexandria<br>
            <a href="https://www.google.com/maps/search/?api=1&amp;query=204%20E%20Bayou%20Dr%2C%20Tallulah%2C%20LA%2071282" class="hover:text-white hover:underline transition">
              204 E Bayou Dr, Tallulah, LA 71282
            </a>
          </p>
        </div>
        
        <div class="flex flex-col md:items-end gap-2 text-sm">
          <a href="/past-bulletins/" class="hover:text-white transition">Past Bulletins</a>
          <a href="/feed.xml" class="hover:text-white transition">Subscribe via RSS</a>
        </div>
      </div>
      
      <div class="mt-12 pt-8 border-t border-white/10 text-xs text-white/70 flex flex-col md:flex-row md:items-center gap-y-2 md:justify-between">
        <div>© 2026 St. Edward the Confessor Catholic Church. All rights reserved.</div>
        <div>Hosted on Netlify</div>
      </div>
    </div>
  </footer>

</body>
</html>
