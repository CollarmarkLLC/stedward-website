---
layout: base.njk
title: Weekly Bulletin
---

<div class="max-w-5xl mx-auto px-6 pt-12 pb-20">
  <div class="max-w-2xl mb-10">
    <span class="uppercase tracking-[3px] text-xs font-semibold text-[#1e3a5f]">St. Edward the Confessor • Tallulah, LA</span>
    <h1 class="text-6xl heading-serif mt-4">Weekly Bulletin</h1>
    <p class="mt-4 text-xl text-stone-600">The latest news and announcements from our parish.</p>
  </div>

  <div class="space-y-8">
    {% for post in collections.posts %}
      <article class="bg-white border border-stone-200 rounded-3xl p-8 hover:border-[#1e3a5f] transition">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <a href="{{ post.url }}" class="text-3xl font-semibold heading-serif hover:text-[#1e3a5f] transition">
              {{ post.data.title }}
            </a>
            <div class="text-sm text-stone-500 mt-1">
              {{ post.date | readableDate }}
            </div>
          </div>
          {% if post.data.image %}
            <img src="{{ post.data.image }}" alt="" class="w-24 h-24 object-cover rounded-2xl border">
          {% endif %}
        </div>

        {% if post.data.summary %}
          <p class="mt-4 text-stone-600 max-w-3xl">{{ post.data.summary }}</p>
        {% endif %}

        <a href="{{ post.url }}" class="inline-block mt-6 text-sm font-medium text-[#1e3a5f] hover:underline">
          Read the full bulletin →
        </a>
      </article>
    {% endfor %}
  </div>
</div>