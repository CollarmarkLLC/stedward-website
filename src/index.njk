---
layout: base.njk
title: Home
---

<!-- Hero -->
<header class="relative bg-parish-blue text-white overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 py-20 md:py-24 relative z-10">
    <div class="max-w-3xl">
      <div class="flex items-center gap-3 mb-4">
        <div class="h-px w-12 bg-white/40"></div>
        <span class="uppercase tracking-[3px] text-xs font-semibold text-white/60">Tallulah, Louisiana • Diocese of Alexandria</span>
      </div>
      
      <h1 class="text-6xl md:text-7xl heading-serif tracking-tight">Parish Life</h1>
      <p class="mt-4 text-2xl text-white/90 max-w-lg">
        Worship, news, and parish information from St. Edward the Confessor Catholic Church.
      </p>
    </div>
    <img src="/images/glyph/St%20Edward%20Glyph%20Outlines.svg" alt="" class="hidden sm:block absolute right-8 lg:right-16 top-1/2 -translate-y-1/2 h-48 md:h-56 w-auto brightness-0 invert opacity-20" aria-hidden="true">
  </div>
  
  <!-- Hero background image -->
  <div class="absolute inset-0 opacity-30">
    <picture>
      <source type="image/webp" srcset="/images/hero-stained-glass-640.webp 640w, /images/hero-stained-glass-960.webp 960w, /images/hero-stained-glass-1280.webp 1280w" sizes="100vw">
      <img src="/images/7148230407_80cc49e672_o.jpg" alt="" width="1704" height="1180" fetchpriority="high" class="absolute inset-0 w-full h-full object-cover object-[center_30%]">
    </picture>
  </div>
</header>

<!-- Bulletins -->
<div class="max-w-6xl mx-auto px-6 pt-12 pb-20">
  <div class="mb-8 flex items-end justify-between">
    <div>
      <span class="text-xs uppercase tracking-[2px] font-semibold text-parish-blue">Latest Issues</span>
      <h2 class="text-4xl heading-serif mt-1">Recent Bulletins</h2>
    </div>
    <div class="hidden md:block text-sm text-stone-500">
      {{ collections.posts | length }} issues published
    </div>
  </div>

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {% for post in collections.recentBulletins %}
      <article class="bulletin-card bg-white border border-stone-200 rounded-3xl overflow-hidden flex flex-col">
        {% if post.data.image %}
          <div class="aspect-[16/9] bg-stone-100 overflow-hidden">
            <picture>
              {% set cardImage = post.data.image | bulletinCardImage %}
              {% if cardImage %}<source type="image/webp" srcset="{{ cardImage }}">{% endif %}
              <img src="{{ post.data.image }}" alt="" loading="lazy" class="w-full h-full object-cover">
            </picture>
          </div>
        {% else %}
          <div class="aspect-[16/9] bg-stone-100 flex items-center justify-center">
            <img src="/images/Inscription.jpeg" alt="" class="w-full h-full object-cover opacity-60">
          </div>
        {% endif %}
        
        <div class="p-6 flex-1 flex flex-col">
          <div class="text-sm text-stone-500 mb-2">
            {{ post.date | readableDate }}
          </div>
          
          <a href="{{ post.url }}" class="text-2xl heading-serif leading-tight hover:text-parish-blue transition flex-1">
            {{ post.data.title }}
          </a>
          
          {% if post.data.summary %}
            <p class="mt-3 text-stone-600 text-[15px] line-clamp-3">
              {{ post.data.summary }}
            </p>
          {% endif %}
          
          <div class="mt-auto pt-6">
            <a href="{{ post.url }}" class="inline-flex items-center text-sm font-medium text-parish-blue hover:underline">
              Read this issue →
            </a>
          </div>
        </div>
      </article>
    {% endfor %}
  </div>

  <div class="mt-10 text-center">
    <a href="/past-bulletins/" class="inline-flex items-center rounded-full bg-parish-blue px-6 py-3 text-sm font-semibold text-white hover:opacity-90 transition">
      View Past Bulletins →
    </a>
  </div>
</div>

<!-- Bulletin subscription stub -->
<section class="bg-stone-100 border-y border-stone-200">
  <div class="max-w-6xl mx-auto px-6 py-14 md:py-16">
    <div class="grid gap-8 md:grid-cols-[1fr_1.1fr] md:items-center">
      <div>
        <span class="text-xs uppercase tracking-[2px] font-semibold text-parish-blue">Stay Connected</span>
        <h2 class="text-4xl heading-serif mt-1">Subscribe to Our Bulletin</h2>
        <p class="mt-3 text-stone-600 max-w-xl">
          Sign up to receive the St. Edward bulletin by email each week.
        </p>
      </div>

      <div class="rounded-3xl bg-white border border-stone-200 p-6 md:p-8 shadow-sm">
        <form class="flex flex-col sm:flex-row gap-3" aria-label="Bulletin subscription coming soon">
          <label for="bulletin-email" class="sr-only">Email address</label>
          <input id="bulletin-email" type="email" placeholder="Email address" disabled class="min-w-0 flex-1 rounded-full border border-stone-300 bg-stone-50 px-5 py-3 text-stone-500 disabled:cursor-not-allowed">
          <button type="button" disabled class="rounded-full bg-parish-blue px-6 py-3 font-semibold text-white opacity-60 disabled:cursor-not-allowed">
            Sign Up
          </button>
        </form>
        <p class="mt-3 text-xs text-stone-500">Email subscriptions are coming soon. This form is not yet active.</p>
      </div>
    </div>
  </div>
</section>

<!-- Parish schedule -->
<section id="times" class="bg-white">
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="max-w-2xl mb-10">
      <span class="text-xs uppercase tracking-[2px] font-semibold text-parish-blue">Worship &amp; Formation</span>
      <h2 class="text-4xl md:text-5xl heading-serif mt-1">Mass, Confession &amp; Catechesis</h2>
      <p class="mt-3 text-stone-600">Regular parish times at St. Edward the Confessor.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <article class="rounded-3xl border border-stone-200 bg-stone-50 p-7">
        <h3 class="text-2xl heading-serif text-parish-blue">Holy Mass on Weekends</h3>
        <dl class="mt-5 space-y-4">
          <div><dt class="font-semibold">Saturday</dt><dd class="text-stone-600">5:30p</dd></div>
          <div><dt class="font-semibold">Sunday</dt><dd class="text-stone-600">8:00a (TLM), 9:30a</dd></div>
        </dl>
      </article>

      <article class="rounded-3xl border border-stone-200 bg-stone-50 p-7">
        <h3 class="text-2xl heading-serif text-parish-blue">Holy Mass on Special Occasions</h3>
        <dl class="mt-5 space-y-4">
          <div><dt class="font-semibold">First Friday with Benediction</dt><dd class="text-stone-600">5:30p</dd></div>
          <div><dt class="font-semibold">Holy Days of Obligation</dt><dd class="text-stone-600">As published</dd></div>
        </dl>
      </article>

      <article class="rounded-3xl border border-stone-200 bg-stone-50 p-7">
        <h3 class="text-2xl heading-serif text-parish-blue">Holy Mass on Weekdays</h3>
        <dl class="mt-5 space-y-4">
          <div><dt class="font-semibold">Tuesday, Wednesday</dt><dd class="text-stone-600">9:00a</dd></div>
          <div><dt class="font-semibold">Thursday</dt><dd class="text-stone-600">9:00a (Legacy Nursing Home)</dd></div>
          <div><dt class="font-semibold">Friday</dt><dd class="text-stone-600">5:30p</dd></div>
        </dl>
      </article>

      <article class="rounded-3xl border border-stone-200 bg-stone-50 p-7 lg:col-span-2">
        <h3 class="text-2xl heading-serif text-parish-blue">Confession</h3>
        <dl class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div><dt class="font-semibold">Friday</dt><dd class="text-stone-600">5:00p</dd></div>
          <div><dt class="font-semibold">Saturday</dt><dd class="text-stone-600">5:00p</dd></div>
          <div><dt class="font-semibold">Sunday</dt><dd class="text-stone-600">9:00a</dd></div>
          <div><dt class="font-semibold">Other Times</dt><dd class="text-stone-600">By appointment</dd></div>
        </dl>
      </article>

      <article class="rounded-3xl bg-parish-blue p-7 text-white">
        <h3 class="text-2xl heading-serif">Catechesis</h3>
        <p class="mt-5 font-semibold">Sunday Morning Catechism</p>
        <p class="mt-1 text-white/75">After the 9:30a Mass</p>
      </article>
    </div>
  </div>
</section>

<!-- Parish services and resources -->
<section class="bg-stone-100 border-t border-stone-200">
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="max-w-2xl mb-10">
      <span class="text-xs uppercase tracking-[2px] font-semibold text-parish-blue">Also Available</span>
      <h2 class="text-4xl md:text-5xl heading-serif mt-1">Parish Services &amp; Resources</h2>
      <p class="mt-3 text-stone-600">Livestream information and guidance for important pastoral needs.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <article class="rounded-3xl bg-parish-blue p-7 md:p-8 text-white">
        <h3 class="text-2xl heading-serif">Livestreams</h3>
        <p class="mt-3 text-white/75">
          Available on
          <a href="https://www.facebook.com/StEdwardTallulah/" class="font-semibold text-white underline decoration-white/40 underline-offset-4 hover:decoration-white" target="_blank" rel="noopener noreferrer">Facebook</a>.
        </p>
        <dl class="mt-6 space-y-4">
          <div><dt class="font-semibold">Sunday Morning Mass</dt><dd class="text-white/75">9:30a</dd></div>
          <div><dt class="font-semibold">Wednesday Morning Mass</dt><dd class="text-white/75">9:00a</dd></div>
          <div>
            <dt class="flex flex-wrap items-center gap-2 font-semibold">
              Wednesday Morning Catechism
              <span class="rounded-full bg-white/15 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider">Currently under repair</span>
            </dt>
            <dd class="text-white/75">After the 9:00a Mass</dd>
          </div>
          <div><dt class="font-semibold">Friday Evening Mass</dt><dd class="text-white/75">5:30p</dd></div>
        </dl>
      </article>

      <article class="rounded-3xl border border-stone-200 bg-white p-7 md:p-8">
        <h3 class="text-2xl heading-serif text-parish-blue">Baptisms, Weddings, Funerals</h3>
        <p class="mt-5 leading-relaxed text-stone-600">
          Please contact Fr. Ryan as soon as possible, as planning and/or preparation may be needed. Please <strong class="font-semibold text-stone-800">do not schedule your date</strong> without verifying that the church is available.
        </p>
      </article>

      <article class="rounded-3xl border border-stone-200 bg-white p-7 md:p-8">
        <h3 class="text-2xl heading-serif text-parish-blue">Anointings &amp; Sick Visits</h3>
        <p class="mt-5 leading-relaxed text-stone-600">
          Please contact the office as soon as possible. Fr. Ryan is happy to visit loved ones locally and, as needed, in Jackson or Monroe.
        </p>
      </article>

      <article class="rounded-3xl border border-stone-200 bg-white p-7 md:p-8">
        <h3 class="text-2xl heading-serif text-parish-blue">Counseling &amp; Spiritual Direction</h3>
        <p class="mt-5 leading-relaxed text-stone-600">
          Fr. Ryan is happy to speak with you, but he is not credentialed in either counseling or Spiritual Direction.
        </p>
      </article>
    </div>
  </div>
</section>

<!-- Contact and location -->
<section class="bg-white border-t border-stone-200">
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="max-w-2xl mb-10">
      <span class="text-xs uppercase tracking-[2px] font-semibold text-parish-blue">Contact &amp; Location</span>
      <h2 class="text-4xl md:text-5xl heading-serif mt-1">Get in Touch</h2>
      <p class="mt-3 text-stone-600">Contact St. Edward or find the parish in Tallulah.</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      <div class="rounded-3xl border border-stone-200 bg-stone-50 p-6 md:p-8">
        <form class="space-y-5" aria-label="Contact form coming soon">
          <div>
            <label for="contact-name" class="block text-sm font-semibold text-stone-700">Name</label>
            <input id="contact-name" type="text" disabled class="mt-2 w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 disabled:cursor-not-allowed">
          </div>
          <div>
            <label for="contact-email" class="block text-sm font-semibold text-stone-700">Email address</label>
            <input id="contact-email" type="email" disabled class="mt-2 w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 disabled:cursor-not-allowed">
          </div>
          <div>
            <label for="contact-message" class="block text-sm font-semibold text-stone-700">Message</label>
            <textarea id="contact-message" rows="5" disabled class="mt-2 w-full resize-none rounded-2xl border border-stone-300 bg-white px-4 py-3 disabled:cursor-not-allowed"></textarea>
          </div>
          <button type="button" disabled class="rounded-full bg-parish-blue px-6 py-3 font-semibold text-white opacity-60 disabled:cursor-not-allowed">Send Message</button>
          <p class="text-xs text-stone-500">Online messages are coming soon. This form is not yet active.</p>
        </form>
      </div>

      <div class="overflow-hidden rounded-3xl border border-stone-200 bg-stone-100 min-h-[420px] flex flex-col">
        <iframe
          title="Map showing St. Edward the Confessor Catholic Church"
          src="https://www.google.com/maps?q=204%20E%20Bayou%20Dr%2C%20Tallulah%2C%20LA%2071282&amp;output=embed"
          class="min-h-[350px] w-full flex-1 border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen>
        </iframe>
        <div class="bg-white p-5">
          <p class="font-semibold text-stone-800">St. Edward the Confessor Catholic Church</p>
          <a href="https://www.google.com/maps/search/?api=1&amp;query=204%20E%20Bayou%20Dr%2C%20Tallulah%2C%20LA%2071282" class="mt-1 inline-block text-sm text-parish-blue hover:underline">
            204 E Bayou Dr, Tallulah, LA 71282 →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
