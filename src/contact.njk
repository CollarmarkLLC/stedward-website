---
layout: base.njk
title: Contact Us
---

<div class="max-w-4xl mx-auto px-6 py-16">
  <span class="uppercase tracking-[3px] text-xs font-semibold text-parish-blue">Get in Touch</span>
  <h1 class="text-6xl heading-serif mt-3">Contact Us</h1>

  <div class="mt-10 grid md:grid-cols-5 gap-x-12 gap-y-10">
    <div class="md:col-span-2">
      <h3 class="font-semibold mb-2">Parish Address</h3>
      <p class="text-stone-600">St. Edward the Confessor<br>Catholic Church<br>Tallulah, Louisiana</p>
      
      <h3 class="font-semibold mt-8 mb-2">Email</h3>
      <p class="text-stone-600">Use the form or contact us directly.</p>
    </div>
    
    <div class="md:col-span-3">
      <form name="contact" method="POST" data-netlify="true" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <input type="text" name="name" placeholder="Your Name" class="w-full border border-stone-300 p-4 rounded-2xl" required>
          <input type="email" name="email" placeholder="Email Address" class="w-full border border-stone-300 p-4 rounded-2xl" required>
        </div>
        <textarea name="message" rows="6" placeholder="How can we help you?" class="w-full border border-stone-300 p-4 rounded-3xl" required></textarea>
        
        <button type="submit" class="px-8 py-4 bg-parish-blue text-white rounded-full font-medium hover:bg-[#162c48] transition">
          Send Message
        </button>
      </form>
    </div>
  </div>
</div>