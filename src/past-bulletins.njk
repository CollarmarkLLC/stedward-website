---
layout: base.njk
title: Past Bulletins
pagination:
  data: collections.pastBulletins
  size: 24
  alias: bulletins
permalink: "past-bulletins/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
---

<header class="bg-parish-blue text-white overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 py-14 md:py-16 relative">
    <div class="relative z-10">
      <span class="text-xs uppercase tracking-[3px] font-semibold text-white/60">Bulletin Archive</span>
      <h1 class="mt-2 text-5xl md:text-6xl heading-serif tracking-tight">Past Bulletins</h1>
      <p class="mt-3 text-lg text-white/80">Browse earlier issues from St. Edward the Confessor.</p>
    </div>
    <img src="/images/glyph/St%20Edward%20Glyph%20Outlines.svg" alt="" class="absolute right-8 lg:right-16 top-1/2 -translate-y-1/2 h-36 md:h-44 w-auto brightness-0 invert opacity-[0.15]" aria-hidden="true">
  </div>
</header>

<main class="max-w-6xl mx-auto px-6 py-12 md:py-16">
  <div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <span class="text-xs uppercase tracking-[2px] font-semibold text-parish-blue">Archive</span>
      <h2 class="text-3xl heading-serif mt-1">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages | length }}</h2>
    </div>
    <a href="/" class="text-sm font-medium text-parish-blue hover:underline">← Recent Bulletins</a>
  </div>

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {% for post in bulletins %}
      <article class="bulletin-card bg-white border border-stone-200 rounded-3xl overflow-hidden flex flex-col">
        <div class="aspect-[16/9] bg-stone-100 overflow-hidden">
          <picture>
            {% set cardImage = post.data.image | bulletinCardImage %}
            {% if cardImage %}<source type="image/webp" srcset="{{ cardImage }}">{% endif %}
            <img src="{{ post.data.image or '/images/Inscription.jpeg' }}" alt="" loading="lazy" class="w-full h-full object-cover">
          </picture>
        </div>

        <div class="p-6 flex-1 flex flex-col">
          <div class="text-sm text-stone-500 mb-2">{{ post.date | readableDate }}</div>
          <a href="{{ post.url }}" class="text-2xl heading-serif leading-tight hover:text-parish-blue transition flex-1">
            {{ post.data.title }}
          </a>
          <div class="mt-auto pt-6">
            <a href="{{ post.url }}" class="inline-flex items-center text-sm font-medium text-parish-blue hover:underline">
              Read this issue →
            </a>
          </div>
        </div>
      </article>
    {% endfor %}
  </div>

  <nav class="mt-12 flex items-center justify-between border-t border-stone-200 pt-8" aria-label="Bulletin archive pages">
    <div>
      {% if pagination.href.previous %}
        <a href="{{ pagination.href.previous }}" class="inline-flex rounded-full border border-stone-300 bg-white px-5 py-2.5 text-sm font-semibold hover:border-parish-blue hover:text-parish-blue transition">← Newer</a>
      {% endif %}
    </div>
    <span class="text-sm text-stone-500">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages | length }}</span>
    <div>
      {% if pagination.href.next %}
        <a href="{{ pagination.href.next }}" class="inline-flex rounded-full border border-stone-300 bg-white px-5 py-2.5 text-sm font-semibold hover:border-parish-blue hover:text-parish-blue transition">Older →</a>
      {% endif %}
    </div>
  </nav>
</main>
