{
  "name": "st-edward-church",
  "version": "1.0.0",
  "description": "St. Edward the Confessor Catholic Church – Tallulah, LA",
  "scripts": {
    "build:css": "tailwindcss -i ./src/assets/css/tailwind.css -o ./_site/assets/css/tailwind.css --minify",
    "build": "npx @11ty/eleventy && npm run build:css",
    "serve": "npm run build && npx @11ty/eleventy --serve",
    "start": "npm run serve"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "tailwindcss": "^3.4.17",
    "@tailwindcss/typography": "^0.5.16"
  }
}