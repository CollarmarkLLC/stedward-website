{
  "name": "st-edward-church",
  "version": "1.0.0",
  "description": "St. Edward the Confessor Catholic Church – Tallulah, LA",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build:css": "tailwindcss -i ./src/assets/css/tailwind.css -o ./_site/assets/css/tailwind.css --minify",
    "build": "eleventy && pnpm run build:css",
    "serve": "pnpm run build && eleventy --serve",
    "start": "pnpm run serve",
    "bulletin:convert": "python3 scripts/convert_bulletin.py",
    "test:bulletin": "python3 -m unittest tests/test_convert_bulletin.py"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "tailwindcss": "^3.4.17",
    "@tailwindcss/typography": "^0.5.16"
  }
}
